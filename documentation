7.2. Camadas de Serviço
ProductService.php (Exemplo)
phpclass ProductService
{
    public function getRecentProducts(int $limit = 12)
    {
        return Product::with('entity', 'category')
            ->where('is_active', true)
            ->whereHas('entity', fn($q) => $q->where('is_active', true))
            ->latest()
            ->limit($limit)
            ->get();
    }
    
    public function getMostViewed(int $limit = 12)
    {
        return Product::with('entity', 'category')
            ->where('is_active', true)
            ->where('views_count', '>=', 5)
            ->whereHas('entity', fn($q) => $q->where('is_active', true))
            ->orderByDesc('views_count')
            ->limit($limit)
            ->get();
    }
    
    public function search(string $query)
    {
        return Product::with('entity', 'category')
            ->where('is_active', true)
            ->where(function($q) use ($query) {
                $q->where('name', 'LIKE', "%{$query}%")
                  ->orWhere('description', 'LIKE', "%{$query}%")
                  ->orWhereHas('entity', fn($sq) => 
                      $sq->where('name', 'LIKE', "%{$query}%")
                  );
            })
            ->get();
    }
}

